# Copy to .env and fill in. .env is gitignored -- never commit real keys.
#   cp .env.example .env

# --- Credentials ------------------------------------------------------------
# At least one is required. With only one key set, the other provider is
# skipped cleanly rather than failing, so the app still works.
OPENAI_API_KEY=sk-...
ANTHROPIC_API_KEY=sk-ant-...

# --- Models -----------------------------------------------------------------
# Providers rename and retire models, so these are configuration, not code.
# If you get a 404 from a provider, a stale model ID here is the first suspect.
OPENAI_MODEL=gpt-5.5
ANTHROPIC_MODEL=claude-opus-5

# --- Harness ----------------------------------------------------------------
# Primary first, then fallbacks in order.
PROVIDER_ORDER=["openai","anthropic"]

# Total tries per provider (not retries-after-the-first), and the gaps
# between them. 3 attempts with [10,20] = 30s worst case per provider.
MAX_ATTEMPTS=3
BACKOFF_SECONDS=[10,20]

# true  = retry only transient failures (429/5xx/timeout); fail over at once
#         on a bad key or unknown model, so a typo doesn't cost 30 seconds.
# false = every error burns the full schedule.
CLASSIFY_ERRORS=true

# Ceiling on a single provider call.
REQUEST_TIMEOUT_SECONDS=90

# Enables the `force_fail` parameter used to demo the fallback chain.
# Turn off for anything public.
FAULT_INJECTION_ENABLED=true

# --- Prompt -----------------------------------------------------------------
# Which named variant from app/prompts.py the engines use.
#   ascii-guard    production; includes the measured ASCII-punctuation rule
#   no-ascii-rule  the control, for reproducing the 7/8 corruption result
# Do not ship with the control selected.
PROMPT_VARIANT=ascii-guard

# --- Observability (optional) -----------------------------------------------
# Off by default. With it off, missing, or the SDK not installed, the app
# behaves identically and /jeopardy2/config reports which of those it was.
#   pip install 'jeopardy2[obs]'    (or: uv pip install -e '.[obs]')
LANGFUSE_ENABLED=false
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
# Self-hosted by default. Prompts (and later, retrieved clue text) are sent
# to whatever this points at, so pointing it at a vendor's cloud is a data
# decision, not just a config one.
LANGFUSE_HOST=http://localhost:3000

# --- Retrieval (phase 2) ----------------------------------------------------
# Plumbing only so far: an index can be built and queried, but it is not yet
# consulted when answering. Off by default; a fresh clone has no clue data.
#   pip install 'jeopardy2[rag]'   (or: make setup-rag)
RETRIEVAL_ENABLED=false

# Where the Chroma store is written. Gitignored, and must stay that way:
# Chroma keeps the document text next to each vector, so committing it would
# commit the clue data this repo deliberately does not redistribute.
INDEX_PATH=data/chroma
COLLECTION_NAME=jeopardy_clues

# How a row becomes embedded text.
#   qa-glued   clue + response in one chunk
#   clue-only  clue only; the honest control for measuring retrieval, since
#              qa-glued puts the answer inside the text you are searching
CHUNK_SCHEME=qa-glued

# `openai` is the real embedder. `hash` is offline, free, deterministic and
# meaningless -- it exists so the pipeline can be exercised without a key.
# Full dataset is ~15.4M tokens to embed; the 4,001-row sample is ~112k.
EMBEDDING_PROVIDER=openai
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=1536

# --- Dataset (phase 2) ------------------------------------------------------
# No clue data ships with this repo. Generate a local sample with `make sample`
# from your own download, or point at the full file for real use:
#   DATASET_PATH=/path/to/jeopardy_clue_dataset/combined_season1-42.tsv
DATASET_PATH=data/jeopardy_sample.tsv

# --- Multi-agent system (ADK, session 3) ------------------------------------
# A separate system from the harness above: it runs on Gemini and has its own
# orchestration. Nothing in app/ imports it.
#   pip install 'jeopardy2[adk]'   (or: make setup-adk)
# Get a key at https://aistudio.google.com/apikey
GOOGLE_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# SQLite export of the clues, queried by our MCP server. Gitignored.
CLUES_DB_PATH=data/clues.sqlite3

# Where the A2A judge agent listens (`make judge`).
JUDGE_AGENT_URL=http://localhost:8001

# --- Logging ----------------------------------------------------------------
LOG_LEVEL=INFO
