# --- Secrets: never commit API keys ---
.env
.env.*
!.env.example

# --- Python ---
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/
dist/
build/
.pytest_cache/
.ruff_cache/
.coverage
htmlcov/

# --- Dataset ---
# No clue data is committed: the source dataset asks that it not be used in a
# public-facing product, and this repo is public. See data/README.md.
data/*.tsv
data/seasons/

# The vector index is derived clue data, not a build artifact you can wave
# through. Chroma stores the document text next to each vector, so committing
# this directory would commit the clue text verbatim -- in a binary blob
# nobody would catch in review.
data/chroma/
*.chroma/

# --- macOS ---
.DS_Store
